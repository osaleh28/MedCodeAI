# Runtime connection: choose Neon's pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Migration connection: choose Neon's direct (unpooled) connection string.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET"
AUTH_URL="http://localhost:3000"
# No OpenAI API key is needed in Phase 1.
