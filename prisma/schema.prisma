generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  passwordHash String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  analyses     BillingAnalysis[]
}

model BillingAnalysis {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String
  syntheticNote        String   @db.Text
  syntheticDataConfirmed Boolean @default(false)
  mdmComplexity        String?
  suggestedCptCode     String?
  rationale            String?  @db.Text
  noteType             String?
  inputMode            String?
  submittedInput       Json?
  structuredAnalysis   Json?
  problemsComplexity   String?
  dataComplexity       String?
  riskComplexity       String?
  documentationGaps    Json?
  hpiRevision          String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId, createdAt])
}

model AuthThrottle {
  key         String   @id
  attempts    Int      @default(1)
  windowStart DateTime @default(now())
}

// Budget amounts include outstanding reservations, in USD microdollars.
model AiBudgetWindow {
  key          String @id
  amountMicros Int
}

model AiUserQuota {
  key         String    @id
  day         String
  attempts    Int
  activeUntil DateTime?
  activeId    String?
}

// No documentation, credentials, or raw user identifiers in usage accounting.
model AiUsageReservation {
  id             String    @id
  userKey        String
  dayKey         String
  monthKey       String
  reservedMicros Int
  chargedMicros  Int?
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime   @default(now())
  finishedAt     DateTime?

  @@index([dayKey])
}
